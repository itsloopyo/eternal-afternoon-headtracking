# Build output
bin/
obj/

# Unity reference stubs, compiled from the tracked UnityStubs.cs by
# scripts/setup-libs.ps1. Generated, never committed.
**/libs/*.dll

# Build references are generated from the stub source in libs/UnityStubs.cs.
**/ref-libs/

# NuGet
packages/
*.nupkg
# But vendored nupkgs are committed - they are the install-time source of truth.
!vendor/**/*.nupkg

# Release packaging
dist/
release/

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo

# Pixi
.pixi/

# AI tooling
.claude/
.millhouse/
.lab/
.cursor/
.windsurf/
.aider*
# Machine-generated agent instructions (authoritative sources live in /c/data)
CLAUDE.md
AGENTS.md
# Skills and MCP servers
skills/
.mcp.json
mcp.json
*.mcp.json

# Installer state (written into game dir by install.cmd, but guard the repo too)
.headtracking-state.json

# Tools (downloaded on demand by ensure-cecil.ps1)
tools/*.dll

# OS
.DS_Store
Thumbs.db
nul

# Nexus mods description
NEXUS_MODS.md
