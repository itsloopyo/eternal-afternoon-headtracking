# Build output
bin/
obj/

# Game reference DLLs (local dev - populated by setup-libs.ps1)
**/libs/*.dll

# Reference assemblies for CI (generated by scripts/generate-ref-assemblies.ps1)
# These contain only type signatures, no implementation - safe to commit
!**/ref-libs/

# NuGet
packages/
*.nupkg
# But vendored nupkgs are committed - they are the install-time source of truth.
!vendor/**/*.nupkg

# Release packaging
dist/
release/

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo

# Pixi
.pixi/

# AI tooling
.claude/
.millhouse/

# Installer state (written into game dir by install.cmd, but guard the repo too)
.headtracking-state.json

# Tools (downloaded on demand by ensure-cecil.ps1)
tools/*.dll

# OS
.DS_Store
Thumbs.db
nul

# Nexus mods description
NEXUS_MODS.md
