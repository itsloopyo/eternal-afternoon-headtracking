<Project>
  <!-- Set UnityEnginePath for all projects including cameraunlock-core submodule
       projects. It points at the stub assemblies scripts/setup-libs.ps1 compiles
       from the checked-in UnityStubs.cs, so a clean checkout builds without a
       game install. Building against a real game install is an explicit
       -p:UnityEnginePath=... opt-in. -->
  <PropertyGroup Condition="'$(UnityEnginePath)' == ''">
    <UnityEnginePath>$(MSBuildThisFileDirectory)src\EternalAfternoonHeadTracking\libs</UnityEnginePath>
  </PropertyGroup>
</Project>
