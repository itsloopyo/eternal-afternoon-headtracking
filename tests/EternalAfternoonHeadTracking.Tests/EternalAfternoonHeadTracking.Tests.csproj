<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48: the framework the mod targets and the one xunit runs the legacy reader on. -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>EternalAfternoonHeadTracking.Tests</AssemblyName>
    <RootNamespace>EternalAfternoonHeadTracking.Tests</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\cameraunlock-core\csharp\src\CameraUnlock.Core\CameraUnlock.Core.csproj" />
  </ItemGroup>

  <!-- The Unity reference stubs `pixi run setup` compiles, copied beside the tests so the legacy
       reader's KeyCode, Color and Mathf run in the test host. -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>..\..\src\EternalAfternoonHeadTracking\libs\UnityEngine.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The units under test are compiled in from the mod's sources: a ProjectReference to the mod
       would bring the Unity runtime assemblies into the test host. -->
  <ItemGroup>
    <Compile Include="..\..\src\EternalAfternoonHeadTracking\Legacy\*.cs" Link="Legacy\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\EternalAfternoonHeadTracking\Config\*.cs" Link="Config\%(Filename)%(Extension)" />
    <Compile Include="..\config_differential\**\*.cs" Link="config_differential\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\cameraunlock-core\csharp\testing\IniMutations.cs" Link="IniMutations.cs" />
  </ItemGroup>
</Project>
